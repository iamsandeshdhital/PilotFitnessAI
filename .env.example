# Flask Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
FLASK_ENV=development
FLASK_DEBUG=1

# Database
DATABASE_URL=sqlite:///pilot_fitness.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/pilot_fitness

# Security
SESSION_TIMEOUT=3600
MAX_LOGIN_ATTEMPTS=5

# API Configuration
API_RATE_LIMIT=100

# Email Notifications (optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
NOTIFICATION_EMAIL=admin@airline.com

# Logging
LOG_LEVEL=INFO
LOG_FILE=pilot_fitness.log

# Assessment Thresholds
FIT_THRESHOLD=80
CONDITIONAL_THRESHOLD=60
HIGH_RISK_THRESHOLD=40

# Feature Flags
ENABLE_SOCIAL_MEDIA_ANALYSIS=true
ENABLE_DIGITAL_FOOTPRINT_ANALYSIS=true
ENABLE_RADICALIZATION_DETECTION=true
ENABLE_TRAVEL_HISTORY_ANALYSIS=true
